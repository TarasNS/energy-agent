{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://energy-agent.local/schemas/asset.schema.json",
  "title": "Asset",
  "description": "One generation or storage asset in a portfolio. DRAFT until Milestone A freeze (owners: Dev 3 + Dev 4).",
  "type": "object",
  "required": ["asset_id", "portfolio_id", "name", "technology", "price_zone", "capacity_mw"],
  "additionalProperties": false,
  "properties": {
    "asset_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$", "examples": ["dk1-solar-01"] },
    "portfolio_id": { "type": "string", "examples": ["demo-solar-dk"] },
    "name": { "type": "string" },
    "technology": { "type": "string", "enum": ["solar_pv", "wind_onshore", "bess"] },
    "price_zone": { "$ref": "#/$defs/price_zone" },
    "capacity_mw": { "type": "string", "pattern": "^\\d+(\\.\\d{1,3})?$", "description": "Installed capacity in MW (AC), decimal string." },
    "commissioning_date": { "type": "string", "format": "date" },
    "data_class": { "type": "string", "enum": ["synthetic", "internal", "confidential"], "default": "synthetic", "description": "Stretch: used by the data-class ceiling." }
  },
  "$defs": {
    "price_zone": { "type": "string", "enum": ["DK1", "DK2", "SE3", "SE4", "LT"], "description": "POC uses DK1 only." }
  }
}
