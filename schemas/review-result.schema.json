{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://energy-agent.local/schemas/review-result.schema.json",
  "title": "ReviewResult",
  "description": "Output of one Monthly Curtailment Review. Numbers come from energy-calc; text from the model. DRAFT until Milestone A freeze (owners: Dev 2 + Dev 4 + Dev 5).",
  "type": "object",
  "required": [
    "request",
    "calculation",
    "explanation",
    "recommendation",
    "model_profile"
  ],
  "additionalProperties": false,
  "properties": {
    "request": {
      "type": "object",
      "required": [
        "portfolio",
        "zone",
        "month"
      ],
      "additionalProperties": false,
      "properties": {
        "portfolio": {
          "type": "string"
        },
        "zone": {
          "type": "string"
        },
        "month": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "threshold_eur": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}$"
        }
      }
    },
    "calculation": {
      "description": "Authoritative. Produced only by energy-calc and passed through unchanged.",
      "type": "object",
      "required": [
        "curtailed_mwh",
        "economic_value_eur",
        "assumptions",
        "input_hash",
        "calculation_version"
      ],
      "additionalProperties": true,
      "properties": {
        "curtailed_mwh": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{3}$"
        },
        "economic_value_eur": {
          "type": "string",
          "pattern": "^-?\\d+\\.\\d{2}$",
          "description": "Headline decision value. Formula v1: portfolio negative-price exposure (EVALS.md \u00a72)."
        },
        "lost_revenue_eur": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}$"
        },
        "avoided_negative_cost_eur": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}$"
        },
        "threshold_exceeded": {
          "type": "boolean"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "input_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "calculation_version": {
          "type": "string",
          "examples": [
            "v1"
          ]
        },
        "grid_operator_lost_eur": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}$"
        },
        "negative_price_exposure_eur": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}$"
        },
        "by_asset": {
          "type": "array",
          "description": "Same buckets per asset; the recommendation names the asset.",
          "items": {
            "type": "object",
            "required": [
              "asset_id",
              "negative_price_exposure_eur"
            ],
            "properties": {
              "asset_id": {
                "type": "string"
              },
              "curtailed_mwh": {
                "type": "string"
              },
              "lost_revenue_eur": {
                "type": "string",
                "pattern": "^\\d+\\.\\d{2}$"
              },
              "grid_operator_lost_eur": {
                "type": "string",
                "pattern": "^\\d+\\.\\d{2}$"
              },
              "avoided_negative_cost_eur": {
                "type": "string",
                "pattern": "^\\d+\\.\\d{2}$"
              },
              "negative_price_exposure_eur": {
                "type": "string",
                "pattern": "^\\d+\\.\\d{2}$"
              },
              "threshold_exceeded": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "explanation": {
      "type": "string",
      "description": "Model text. Every number must appear in calculation or request (eval: no-invented-number)."
    },
    "recommendation": {
      "type": "string"
    },
    "model_profile": {
      "type": "string",
      "examples": [
        "frontier",
        "enterprise-cloud",
        "local"
      ]
    },
    "proposal_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
