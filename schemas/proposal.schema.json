{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "proposal.schema.json",
  "title": "Proposal",
  "description": "An action proposed by the model (SPEC.md §5). It records only; nothing runs until a person approves it.",
  "type": "object",
  "required": ["id", "action", "asset", "reason", "status"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^prop_[0-9a-f]{12}$"},
    "action": {"enum": ["enable_negative_price_curtailment", "schedule_inspection", "review_ppa_volume"]},
    "asset": {"enum": ["portfolio", "north", "south", "battery"]},
    "reason": {"type": "string"},
    "status": {"enum": ["pending", "approved", "refused"]}
  }
}
