# Copy to .env (git-ignored). Never commit real values.

# default | fast | offline   (mapping in model/profiles.json)
MODEL_PROFILE=default

# proposal_only is the only allowed value for the hackathon build
ACTION_MODE=proposal_only

AUDIT_LOG_PATH=./artifacts/audit.jsonl

# synthetic | api   (api = the organizers' energy data API; falls back to synthetic)
ENERGY_DATA_MODE=synthetic
ORGANIZER_API_URL=
ORGANIZER_API_KEY=

# Provider credentials: set locally or as CI secrets only.
ANTHROPIC_API_KEY=
